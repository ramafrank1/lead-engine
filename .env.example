# Copiá este archivo como `.env` y completá los valores. `.env` nunca se sube a git.

# --- Google Cloud (Places API (New) + PageSpeed Insights) ---
# Consola: https://console.cloud.google.com/ → APIs y servicios → Credenciales → Crear clave de API.
# Restringila a "Places API (New)" y "PageSpeed Insights API".
GOOGLE_API_KEY=

# --- Supabase (Postgres) ---
# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI).
# Si lo dejás vacío, `lead hunt` corre en modo prueba: no guarda nada, solo exporta CSV.
DATABASE_URL=

# --- Datos de Google Places ---
# Días que se guarda la copia temporal de los datos de Places (nombre, teléfono, web...).
# Pasado ese plazo se borran con `lead purge-cache`. Solo el place_id se guarda para siempre.
PLACES_CACHE_DAYS=30

# --- IA (opcional, gratis por defecto) ---
# none | claude-code | ollama | gemini | anthropic
AI_PROVIDER=none
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Gmail de envío (canal email) ---
# Guía paso a paso: docs/email/fase-2-gmail-google-cloud.md
# Cliente OAuth "App de escritorio" del proyecto de Google Cloud (con la Gmail API habilitada).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Lo completa solo `lead gmail-auth`. Nunca uses tu cuenta personal para enviar en frío.
GMAIL_REFRESH_TOKEN=

# --- Telegram (desde la Fase 3) ---
TELEGRAM_BOT_TOKEN=

# Mails desde los que nunca se envía en frío (separados por coma)
CUENTAS_PROTEGIDAS=
TELEGRAM_CHAT_ID=

# --- Tus datos (para mensajes y PDFs) ---
OWNER_NAME=Ramiro Frank
OWNER_WHATSAPP=
OWNER_PORTFOLIO=https://ramirofrank.pages.dev/
# Obligatoria en los emails a EE.UU. (CAN-SPAM). Puede ser una casilla postal o una dirección comercial.
OWNER_POSTAL_ADDRESS=
